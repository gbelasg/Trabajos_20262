package co.edu.uniquindio.poo;

public class Matrices {
    public static void main(String[] args){

        int matriz [][]= {{6, 7, 4},
                {-5, 8, -2},
                {9, 12, -8}
        };
        //Impresión de la primera matriz
        imprimirMatriz(matriz);
        //Suma de los numeros de la matriz
        int sumafinal= sumarMatriz(matriz);
        System.out.println( "La suma de los numeros que la matriz contiene es: " +sumafinal);
        //Sumar numeros de la diagonal principal
        int diagonal=sumarDiagonalMatriz(matriz);
        System.out.println("La suma de la diagonal de la matriz es: " +diagonal);
        //Sumar numeros de la diagonal secundaria
        int diagonalSecundaria= sumarSecundaria(matriz);
        System.out.println("La suma de la diagonal secundaria de la matriz es: " +diagonalSecundaria);

        //Dibujos de x en matriz
        dibujarEquis(matriz);
        System.out.println();
        //cuadro exterior en una matriz
        int tamanio= 5;
        obtenerCuadroSuperior(tamanio);
        //Matriz espiral de numeros
        int[][] matrizEspiral= new int [10][10];
        crearEspiral(matrizEspiral, tamanio);



    }
    //al ser void no retorna nada solo imprime
    public static void imprimirMatriz(int[][]matriz){
        for(int i=0; i<matriz.length;i++){
            for (int j=0; j<matriz[i].length;j++){
                System.out.print(matriz[i][j]+ "\t"); //esto ultimo se utiliza para hacer un espacio de tabulación y que quede mas amplio, tambien se puede con solo un espacio

            }
            // se utiliza para un salto de linea
            System.out.println();
        }
    }
    public static int sumarMatriz(int[][]matriz){
        int suma=0;
        for (int i=0; i<matriz.length;i++){
            for (int j=0; j<matriz[i].length;j++){
                suma+=matriz[i][j];
            }
        }
        return suma;
    }
    public static int sumarDiagonalMatriz(int [][] matriz){
        int sumaDiagonal= 0;
        for (int i=0; i<matriz.length;i++){
            for (int j=0; j<matriz[i].length;j++){
                if(i==j){
                    sumaDiagonal+=matriz[i][j];
                }
            }
        }
        return sumaDiagonal;
    }
    public static int sumarSecundaria(int [][] matriz){
        int sumaSecunadaria= 0;
        for (int i=0; i<matriz.length;i++){
            for (int j=0; j<matriz[i].length;j++){
                if (i+j == (matriz.length-1)){ //por la posicion relacionada con la diagonal secundaria
                    sumaSecunadaria+=matriz[i][j];
                }
            }
            }

        return sumaSecunadaria;
    }
    public static void dibujarEquis( int[][]matriz){
        for (int i= 0; i<matriz.length; i++){
            for (int j=0; j<matriz.length; j++){
                if (i==j || i+j== matriz.length-1){ //concepto: diagonal principal y diagonal secundaria
                    matriz[i][j]= 0;
                }
                System.out.print(matriz[i][j] + " \t"); //no se pone ln para que no haya un salto de linea
            }
            System.out.println();
        }

    }

    public static void obtenerCuadroSuperior(int tamanio) {

        for (int i = 0; i < tamanio; i++) {
            for (int j = 0; j < tamanio; j++) {
                if (i == 0 || i == tamanio - 1 || j == 0 || j == tamanio - 1) { // ubicacion de las filas y columnas de el cuadro 
                    System.out.print(0 + "\t");
                }else{
                    System.out.print(7 + "\t");
                }
            }
            System.out.println();

            }


    }
    public static void crearEspiral(int[][] matrizEspiral, int tamanio){
        int inicio=0; int limite= tamanio-1; int contador= 1;
        while(contador<=tamanio*tamanio){
            for (int i=inicio; i<=limite; i++ ){
                matrizEspiral[inicio][i]=contador++; //van variando las filas y columnas segun se recorre el espiral
            }
            for(int i= inicio+1; i<=limite; i++){
                matrizEspiral[i][limite]=contador++;
            }
            for(int i=limite-1; i>= inicio; i--){ //Al ir decrementado se invierte el signo
                matrizEspiral[limite][i]=contador++;
            }
            for(int i=limite-1; i>=inicio+1; i--){
                matrizEspiral[i][inicio]=contador++;
            }
            inicio=inicio+1;
            limite= limite-1; //Se hace para ir reduciendo la matriz sucesivamente
        }
        for (int i=0; i<tamanio; i++){
            System.out.println();
            for (int j=0; j<tamanio; j++){
                System.out.print(matrizEspiral[i][j] +"\t");
            }
        }

    }
}
